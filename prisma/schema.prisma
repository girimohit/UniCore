generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model academicperiod {
  id          String       @id
  tenant_id   String
  name        String
  type        String
  start_date  DateTime
  end_date    DateTime
  created_at  DateTime     @default(now())
  institution institution  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "AcademicPeriod_tenant_id_fkey")
  attendance  attendance[]
  exam        exam[]

  @@index([tenant_id], map: "AcademicPeriod_tenant_id_idx")
}

model attendance {
  id             String            @id
  tenant_id      String
  studentId      String
  subjectId      String
  date           DateTime
  status         attendance_status
  created_at     DateTime          @default(now())
  updated_at     DateTime
  periodId       String?
  academicperiod academicperiod?   @relation(fields: [periodId], references: [id], map: "Attendance_periodId_fkey")
  studentprofile studentprofile    @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "Attendance_studentId_fkey")
  subject        subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "Attendance_subjectId_fkey")
  institution    institution       @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Attendance_tenant_id_fkey")

  @@unique([studentId, subjectId, date], map: "Attendance_studentId_subjectId_date_key")
  @@index([periodId], map: "Attendance_periodId_fkey")
  @@index([subjectId], map: "Attendance_subjectId_fkey")
  @@index([tenant_id], map: "Attendance_tenant_id_idx")
  @@index([tenant_id, studentId], map: "Attendance_tenant_id_studentId_idx")
  @@index([tenant_id, subjectId], map: "Attendance_tenant_id_subjectId_idx")
}

model course {
  id             String           @id
  tenant_id      String
  name           String
  code           String
  departmentId   String
  created_at     DateTime         @default(now())
  updated_at     DateTime
  department     department       @relation(fields: [departmentId], references: [id], onDelete: Cascade, map: "Course_departmentId_fkey")
  institution    institution      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Course_tenant_id_fkey")
  enrolledcourse enrolledcourse[]
  exam           exam[]
  studentprofile studentprofile[]
  subject        subject[]

  @@unique([tenant_id, code], map: "Course_tenant_id_code_key")
  @@index([departmentId], map: "Course_departmentId_fkey")
  @@index([tenant_id, departmentId], map: "Course_tenant_id_departmentId_idx")
  @@index([tenant_id], map: "Course_tenant_id_idx")
}

model department {
  id             String           @id
  tenant_id      String
  name           String
  code           String
  created_at     DateTime         @default(now())
  updated_at     DateTime
  course         course[]
  institution    institution      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Department_tenant_id_fkey")
  facultyprofile facultyprofile[]

  @@unique([tenant_id, code], map: "Department_tenant_id_code_key")
  @@index([tenant_id], map: "Department_tenant_id_idx")
}

model enrolledcourse {
  id             String         @id
  studentId      String
  courseId       String
  course         course         @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "EnrolledCourse_courseId_fkey")
  studentprofile studentprofile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "EnrolledCourse_studentId_fkey")

  @@unique([studentId, courseId], map: "EnrolledCourse_studentId_courseId_key")
  @@index([courseId], map: "EnrolledCourse_courseId_idx")
  @@index([studentId], map: "EnrolledCourse_studentId_idx")
}

model exam {
  id             String         @id
  tenant_id      String
  name           String
  date           DateTime
  courseId       String
  subjectId      String
  created_at     DateTime       @default(now())
  updated_at     DateTime
  periodId       String
  course         course         @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "Exam_courseId_fkey")
  academicperiod academicperiod @relation(fields: [periodId], references: [id], onDelete: Cascade, map: "Exam_periodId_fkey")
  subject        subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "Exam_subjectId_fkey")
  institution    institution    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Exam_tenant_id_fkey")
  grade          grade[]

  @@index([courseId], map: "Exam_courseId_fkey")
  @@index([periodId], map: "Exam_periodId_fkey")
  @@index([subjectId], map: "Exam_subjectId_fkey")
  @@index([tenant_id, courseId], map: "Exam_tenant_id_courseId_idx")
  @@index([tenant_id], map: "Exam_tenant_id_idx")
  @@index([tenant_id, periodId], map: "Exam_tenant_id_periodId_idx")
  @@index([tenant_id, subjectId], map: "Exam_tenant_id_subjectId_idx")
}

model facultyprofile {
  id              String          @id
  user_id         String          @unique(map: "FacultyProfile_user_id_key")
  employee_number String
  department_id   String?
  designation     String?
  department      department?     @relation(fields: [department_id], references: [id], map: "FacultyProfile_department_id_fkey")
  user            user            @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "FacultyProfile_user_id_fkey")
  taughtsubject   taughtsubject[]

  @@index([department_id], map: "FacultyProfile_department_id_fkey")
}

model grade {
  id             String         @id
  tenant_id      String
  examId         String
  studentId      String
  score          Float
  remarks        String?
  created_at     DateTime       @default(now())
  updated_at     DateTime
  exam           exam           @relation(fields: [examId], references: [id], onDelete: Cascade, map: "Grade_examId_fkey")
  studentprofile studentprofile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "Grade_studentId_fkey")
  institution    institution    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Grade_tenant_id_fkey")

  @@unique([examId, studentId], map: "Grade_examId_studentId_key")
  @@index([studentId], map: "Grade_studentId_fkey")
  @@index([tenant_id, examId], map: "Grade_tenant_id_examId_idx")
  @@index([tenant_id], map: "Grade_tenant_id_idx")
  @@index([tenant_id, studentId], map: "Grade_tenant_id_studentId_idx")
}

model institution {
  id                String                      @id
  name              String
  slug              String                      @unique(map: "Institution_slug_key")
  status            String                      @default("ACTIVE")
  created_at        DateTime                    @default(now())
  updated_at        DateTime
  academic_system   institution_academic_system @default(SEMESTER)
  academicperiod    academicperiod[]
  attendance        attendance[]
  course            course[]
  department        department[]
  exam              exam[]
  grade             grade[]
  institutionmodule institutionmodule[]
  invitationtoken   invitationtoken[]
  subject           subject[]
  user              user[]

  @@index([slug], map: "Institution_slug_idx")
}

model institutionmodule {
  id          String      @id
  tenant_id   String
  moduleId    String
  isEnabled   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime
  module      module      @relation(fields: [moduleId], references: [id], onDelete: Cascade, map: "InstitutionModule_moduleId_fkey")
  institution institution @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "InstitutionModule_tenant_id_fkey")

  @@unique([tenant_id, moduleId], map: "InstitutionModule_tenant_id_moduleId_key")
  @@index([moduleId], map: "InstitutionModule_moduleId_fkey")
  @@index([tenant_id], map: "InstitutionModule_tenant_id_idx")
}

model invitationtoken {
  id          String               @id
  tenant_id   String
  email       String
  role        invitationtoken_role
  token       String               @unique(map: "InvitationToken_token_key")
  expires_at  DateTime
  used        Boolean              @default(false)
  created_at  DateTime             @default(now())
  institution institution          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "InvitationToken_tenant_id_fkey")

  @@index([tenant_id, email], map: "InvitationToken_tenant_id_email_idx")
  @@index([tenant_id], map: "InvitationToken_tenant_id_idx")
  @@index([token], map: "InvitationToken_token_idx")
}

model module {
  id                String              @id
  name              String              @unique(map: "Module_name_key")
  description       String?
  created_at        DateTime            @default(now())
  updated_at        DateTime
  institutionmodule institutionmodule[]
}

model studentprofile {
  id             String           @id
  user_id        String           @unique(map: "StudentProfile_user_id_key")
  roll_number    String
  course_id      String?
  semester       Int?
  phone          String?
  attendance     attendance[]
  enrolledcourse enrolledcourse[]
  grade          grade[]
  course         course?          @relation(fields: [course_id], references: [id], map: "StudentProfile_course_id_fkey")
  user           user             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "StudentProfile_user_id_fkey")

  @@unique([user_id, roll_number], map: "StudentProfile_user_id_roll_number_key")
  @@index([course_id], map: "StudentProfile_course_id_fkey")
}

model subject {
  id            String          @id
  tenant_id     String
  name          String
  code          String
  courseId      String
  created_at    DateTime        @default(now())
  updated_at    DateTime
  attendance    attendance[]
  exam          exam[]
  course        course          @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "Subject_courseId_fkey")
  institution   institution     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "Subject_tenant_id_fkey")
  taughtsubject taughtsubject[]

  @@unique([tenant_id, code], map: "Subject_tenant_id_code_key")
  @@index([courseId], map: "Subject_courseId_fkey")
  @@index([tenant_id, courseId], map: "Subject_tenant_id_courseId_idx")
  @@index([tenant_id], map: "Subject_tenant_id_idx")
}

model taughtsubject {
  id             String         @id
  subjectId      String
  facultyId      String
  facultyprofile facultyprofile @relation(fields: [facultyId], references: [id], onDelete: Cascade, map: "TaughtSubject_facultyId_fkey")
  subject        subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "TaughtSubject_subjectId_fkey")

  @@unique([subjectId, facultyId], map: "TaughtSubject_subjectId_facultyId_key")
  @@index([facultyId], map: "TaughtSubject_facultyId_idx")
  @@index([subjectId], map: "TaughtSubject_subjectId_idx")
}

model user {
  id             String          @id
  tenant_id      String
  identifier     String
  password_hash  String
  role           user_role
  email          String?
  status         String          @default("ACTIVE")
  created_at     DateTime        @default(now())
  updated_at     DateTime
  facultyprofile facultyprofile?
  studentprofile studentprofile?
  institution    institution     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "User_tenant_id_fkey")

  @@unique([tenant_id, identifier], map: "User_tenant_id_identifier_key")
  @@index([identifier], map: "User_identifier_idx")
  @@index([tenant_id], map: "User_tenant_id_idx")
}

enum invitationtoken_role {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
}

enum user_role {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
}

enum attendance_status {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum institution_academic_system {
  SEMESTER
  ANNUAL
}
