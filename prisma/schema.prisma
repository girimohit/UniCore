generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

model AcademicTerm {
  id            String             @id @default(cuid())
  institutionId String
  name          String
  type          String
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime           @default(now())
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  attendances   AttendanceRecord[]
  exams         Exam[]

  @@index([institutionId])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  institutionId  String
  studentId      String
  subjectId      String
  termId         String?
  attendanceDate DateTime
  status         AttendanceStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  term           AcademicTerm?    @relation(fields: [termId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  institution    Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, attendanceDate])
  @@index([termId])
  @@index([subjectId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, subjectId])
}

model Course {
  id                String             @id @default(cuid())
  institutionId     String
  name              String
  code              String
  departmentId      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseEnrollments CourseEnrollment[]
  exams             Exam[]
  students          Student[]
  subjects          Subject[]

  @@unique([institutionId, code])
  @@index([departmentId])
  @@index([institutionId, departmentId])
  @@index([institutionId])
}

model Department {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  code          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  courses       Course[]
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  faculties     Faculty[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model CourseEnrollment {
  id        String  @id @default(cuid())
  studentId String
  courseId  String
  
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model Exam {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  examDate      DateTime
  courseId      String
  subjectId     String
  termId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term          AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examResults   ExamResult[]

  @@index([courseId])
  @@index([termId])
  @@index([subjectId])
  @@index([institutionId, courseId])
  @@index([institutionId])
  @@index([institutionId, termId])
  @@index([institutionId, subjectId])
}

model Faculty {
  id                String              @id @default(cuid())
  userId            String              @unique
  employeeNumber    String
  departmentId      String?
  designation       String?
  
  department        Department?         @relation(fields: [departmentId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyAssignments FacultyAssignment[]

  @@index([departmentId])
}

model ExamResult {
  id             String      @id @default(cuid())
  institutionId  String
  examId         String
  studentId      String
  obtainedMarks  Float
  teacherRemarks String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  exam           Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([institutionId, examId])
  @@index([institutionId])
  @@index([institutionId, studentId])
}

model Institution {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  status            String               @default("ACTIVE")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  academicSystem    AcademicSystem       @default(SEMESTER)
  academicStructure Json?                @default("{\"type\":\"SEMESTER\", \"totalCycles\":8}")
  
  academicTerms       AcademicTerm[]
  attendanceRecords   AttendanceRecord[]
  courses             Course[]
  departments         Department[]
  exams               Exam[]
  examResults         ExamResult[]
  moduleSubscriptions ModuleSubscription[]
  userInvitations     UserInvitation[]
  subjects            Subject[]
  users               User[]

  @@index([slug])
}

model ModuleSubscription {
  id            String      @id @default(cuid())
  institutionId String
  moduleId      String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  module        Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, moduleId])
  @@index([moduleId])
  @@index([institutionId])
}

model UserInvitation {
  id            String         @id @default(cuid())
  institutionId String
  email         String
  role          InvitationRole
  token         String         @unique
  expiresAt     DateTime
  isUsed        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, email])
  @@index([institutionId])
  @@index([token])
}

model Module {
  id            String               @id @default(cuid())
  name          String               @unique
  description   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions ModuleSubscription[]
}

model Student {
  id                String             @id @default(cuid())
  userId            String             @unique
  rollNumber        String
  courseId          String?
  semester          Int?
  dateOfBirth       DateTime?
  gender            String?
  
  attendanceRecords AttendanceRecord[]
  courseEnrollments CourseEnrollment[]
  examResults       ExamResult[]
  course            Course?            @relation(fields: [courseId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rollNumber])
  @@index([courseId])
}

model Subject {
  id                 String              @id @default(cuid())
  institutionId      String
  name               String
  code               String
  courseId           String
  academicCycle      Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  attendances        AttendanceRecord[]
  exams              Exam[]
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyAssignments FacultyAssignment[]

  @@unique([institutionId, code])
  @@index([courseId])
  @@index([institutionId, courseId])
  @@index([institutionId])
}

model FacultyAssignment {
  id        String  @id @default(cuid())
  subjectId String
  facultyId String
  
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, facultyId])
  @@index([facultyId])
  @@index([subjectId])
}

model User {
  id            String      @id @default(cuid())
  institutionId String
  username      String
  passwordHash  String
  name          String      @default("New User")
  email         String?
  phone         String?
  avatarUrl     String?
  role          UserRole
  accountStatus String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  faculty       Faculty?
  student       Student?
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, username])
  @@index([username])
  @@index([institutionId])
}

enum InvitationRole {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AcademicSystem {
  SEMESTER
  ANNUAL
  YEARLY
}
